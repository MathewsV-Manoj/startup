    <!-- Restricted setting help (Android 13+) -->
    <string name="restricted_title">Accessibility is greyed out?</string>
    <string name="restricted_body">Android locks this switch for apps installed from a file instead of the Play Store. It is a safety rule, and you can unlock it yourself in about a minute:</string>
    <string name="restricted_step1">Tap the greyed-out Focuno once in the Accessibility list. Android says \"Restricted setting\". Tap OK.</string>
    <string name="restricted_step2">Come back here and tap the button below to open Focuno\'s app info.</string>
    <string name="restricted_step3">Tap the three dots in the top right corner, then tap Allow restricted settings and confirm.</string>
    <string name="restricted_step4">Go back to Accessibility, tap Focuno and switch it on.</string>
    <string name="restricted_note">No three dots, or no Allow restricted settings? Do step 1 again first. The menu only appears after Android has shown that message.</string>
    <string name="restricted_open_app_info">Open Focuno app info</string>

    <!-- Phone-maker keep-alive guidance -->
    <string name="oem_card_title">Keep Focuno running on %1$s</string>
    <string name="oem_card_body">These settings stop your phone from quietly shutting Focuno down. Exact names vary a little between software versions.</string>
    <string name="oem_open_settings">Open the settings screen</string>
    <string name="oem_xiaomi_name">Xiaomi, Redmi or POCO</string>
    <string name="oem_xiaomi_step1">Open Settings, then Apps, then Manage apps, then Focuno.</string>
    <string name="oem_xiaomi_step2">Turn on Autostart, and set Battery saver to No restrictions.</string>
    <string name="oem_xiaomi_step3">In the recent apps screen, press and hold Focuno and tap the lock icon.</string>
    <string name="oem_oppo_name">Oppo or Realme</string>
    <string name="oem_oppo_step1">Open Settings, then Apps, then App management, then Focuno.</string>
    <string name="oem_oppo_step2">Turn on Allow auto-launch (or Auto-start).</string>
    <string name="oem_oppo_step3">Under Battery usage, choose Allow background activity.</string>
    <string name="oem_vivo_name">Vivo or iQOO</string>
    <string name="oem_vivo_step1">Open Settings, then Battery, then Background power consumption management.</string>
    <string name="oem_vivo_step2">Find Focuno and choose Allow high background power consumption.</string>
    <string name="oem_vivo_step3">Open i Manager, then App manager, then Autostart, and turn Focuno on.</string>
    <string name="oem_oneplus_name">OnePlus</string>
    <string name="oem_oneplus_step1">Open Settings, then Battery, then Battery optimization, then Focuno.</string>
    <string name="oem_oneplus_step2">Choose Don\'t optimize.</string>
    <string name="oem_oneplus_step3">Open Settings, then Apps, then Focuno, and allow auto-launch and background activity.</string>
    <string name="oem_samsung_name">Samsung</string>
    <string name="oem_samsung_step1">Open Settings, then Battery, then Background usage limits.</string>
    <string name="oem_samsung_step2">Add Focuno to Never sleeping apps.</string>
    <string name="oem_samsung_step3">Open Settings, then Apps, then Focuno, then Battery, and choose Unrestricted.</string>
    <string name="oem_other_name">your phone</string>
    <string name="oem_other_step1">Open Settings, then Apps, then Focuno, then Battery.</string>
    <string name="oem_other_step2">Choose Unrestricted (or Don\'t optimize) and allow background activity.</string>
    <string name="oem_other_step3">If your phone has an Autostart or App launch setting, turn it on for Focuno.</string>

